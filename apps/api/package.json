{
  "name": "@bella-vista/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the water payment system (Fastify + PostgreSQL)",
  "type": "module",
  "files": [
    "dist",
    "src/db/migrations"
  ],
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=development --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bella-vista/shared": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.7",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/sensible": "6.0.7",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
