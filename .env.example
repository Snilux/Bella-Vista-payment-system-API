
# --- Database (db container) ---
POSTGRES_USER=agua
POSTGRES_PASSWORD=agua_local
POSTGRES_DB=agua
DB_PORT=5432
# Password of the API database user agua_api (use a strong value outside local development).
POSTGRES_API_PASSWORD=agua_api_local

# --- API ---
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
BUSINESS_TIMEZONE=America/Mexico_City


# The API connects as agua_api (SELECT/INSERT and status-column UPDATEs only).
DATABASE_URL=postgres://agua_api:agua_api_local@db:5432/agua
# Migrations only (pnpm db:migrate): the owner, who can create and alter objects.
DATABASE_URL_MIGRATIONS=postgres://agua:agua_local@db:5432/agua

DATABASE_URL_TEST=postgres://agua:agua_local@db:5432/agua_test

JWT_ACCESS_SECRET=replace-with-a-random-value-of-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
