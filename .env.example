
# --- Database (db container) ---
POSTGRES_USER=agua
POSTGRES_PASSWORD=agua_local
POSTGRES_DB=agua
DB_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
BUSINESS_TIMEZONE=America/Mexico_City
# Proxies allowed to set X-Forwarded-For (the client IP used by the login rate limit):
# false (default, no proxy), the number of proxies in front of the API (e.g. 1 behind the
# platform's HTTPS proxy), or their addresses/CIDRs separated by commas. Never "true".
TRUST_PROXY=false


# The API connects as agua_api (SELECT/INSERT and status-column UPDATEs only). This URL is the
# only source of its password: pnpm db:migrate sets it on the role every time it runs, so after
# changing it run pnpm db:migrate (use a strong value outside local development).
DATABASE_URL=postgres://agua_api:agua_api_local@db:5432/agua
# Migrations only (pnpm db:migrate): the owner, who can create and alter objects.
DATABASE_URL_MIGRATIONS=postgres://agua:agua_local@db:5432/agua

DATABASE_URL_TEST=postgres://agua:agua_local@db:5432/agua_test

JWT_ACCESS_SECRET=replace-with-a-random-value-of-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
