
# --- Database (db container) ---
POSTGRES_USER=agua
POSTGRES_PASSWORD=agua_local
POSTGRES_DB=waters
DB_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
BUSINESS_TIMEZONE=America/Mexico_City


DATABASE_URL=postgres://agua:agua_local@db:5432/agua

DATABASE_URL_TEST=postgres://agua:agua_local@db:5432/agua_test

JWT_ACCESS_SECRET=replace-with-a-random-value-of-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
